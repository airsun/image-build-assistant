# 环境配置模板
# 每个局域网环境一份，存放在 remote-envs/{env-name}.env
# 项目通过 projects.yaml 的 env 字段声明归属环境

# === Build Host (required) ===
REMOTE_HOST=build.example.internal
REMOTE_PORT=22
REMOTE_USER=builder
SSH_KEY_PATH=~/.ssh/id_rsa
REMOTE_BASE_DIR=/opt/image-build-assistant
PLATFORM=linux/amd64

# === Harbor (optional) ===
# 不填 HARBOR_HOST 时镜像 tag 为纯 IMAGE_NAME:VERSION，不 push
HARBOR_HOST=harbor.example.com
HARBOR_PROJECT=library
PUSH=true
PUSH_LATEST=true

# === Deploy Host（可选；仅在使用 deploy.sh 推送 K8s 清单时必填）===
# 与 REMOTE_HOST（构建机）可相同或不同：此处是「接收 AI 生成的 YAML 目录」的 SSH 目标。
# build.sh 不校验这些变量；仅 deploy.sh 会要求下面四项均有值（DEPLOY_PORT 默认 22）。
#
# DEPLOY_HOST       部署机主机名或 IP
# DEPLOY_PORT       SSH 端口，默认 22
# DEPLOY_USER       SSH 登录用户（需对 DEPLOY_BASE_DIR 下有建目录与写入权限）
# DEPLOY_SSH_KEY_PATH  SSH 私钥路径（本机路径，供 ssh/scp -i 使用）
# DEPLOY_BASE_DIR   远端根目录；清单最终落在 {DEPLOY_BASE_DIR}/{project名}/{version}/
DEPLOY_HOST=deploy.example.internal
DEPLOY_PORT=22
DEPLOY_USER=deployer
DEPLOY_SSH_KEY_PATH=~/.ssh/id_deploy
DEPLOY_BASE_DIR=/opt/k8s-deploys
